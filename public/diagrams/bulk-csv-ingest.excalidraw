    {
      "id": "t_legend",
      "type": "text",
      "x": 1379.9486386999247,
      "y": 654.0448438862994,
      "width": 270,
      "height": 380,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "fontFamily": 1,
      "fontSize": 11,
      "textAlign": "left",
      "verticalAlign": "top",
      "text": "LEGEND\n\n── ▶  Sync call (blocking)\n── >  Async / fire-and-forget\n╌╌ ▶  Polling / cron\n╌╌ >  Secondary background async\n\nArrows: initiator → dependency\n\nColor → Role:\n  Blue    = UI / frontend\n  Teal    = Service / API\n  Orange  = DB / cache / store\n  Red     = Queue / stream\n  Gray    = External system\n  Indigo  = Person / actor\n\nAll nodes: rounded rect\nRole = color + type label\n[brackets] = technology\n\n╌╌╌  Grouping boundary (dashed)",
      "roundness": null,
      "boundElements": [],
      "containerId": "n_legend",
      "version": 106,
      "versionNonce": 1809435949,
      "index": "aZ",
      "isDeleted": false,
      "seed": 1,
      "groupIds": [],
      "frameId": null,
      "updated": 1777759202914,
      "link": null,
      "locked": false,
      "originalText": "LEGEND\n\n── ▶  Sync call (blocking)\n── >  Async / fire-and-forget\n╌╌ ▶  Polling / cron\n╌╌ >  Secondary background async\n\nArrows: initiator → dependency\n\nColor → Role:\n  Blue    = UI / frontend\n  Teal    = Service / API\n  Orange  = DB / cache / store\n  Red     = Queue / stream\n  Gray    = External system\n  Indigo  = Person / actor\n\nAll nodes: rounded rect\nRole = color + type label\n[brackets] = technology\n\n╌╌╌  Grouping boundary (dashed)",
      "autoResize": true,
      "lineHeight": 1.5702479338842976
    },
