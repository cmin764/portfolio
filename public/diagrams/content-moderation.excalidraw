    {
      "id": "t_legend",
      "type": "text",
      "x": 2386.437892407777,
      "y": 665.8890053414086,
      "width": 294.2068176269531,
      "height": 436,
      "text": "Legend:\n── (solid + filled ▶)  Sync call (sender blocks)\n─▷ (solid + open ▷)   Async / fire-and-forget\n╌╌ (dashed + filled ▶) Cron / polling\n╌╌▷ (dashed + open ▷)  Secondary background async\n\n↓ Arrows point from initiator to dependency\n\nColor → role:\n  blue   = UI / Frontend\n  teal   = Service / API / Worker\n  orange = DB / Cache / Store\n  red    = Queue / Stream\n  gray   = External system\n  indigo = Person / User\n\nAll nodes: rounded rect. Role = color + label.\n[] = tech    () = status\n\n╌╌╌ GROUPING BOUNDARY (dashed)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "legend",
      "strokeColor": "#1e1e1e",
      "seed": 9002,
      "opacity": 100,
      "boundElements": [],
      "version": 598,
      "versionNonce": 723555486,
      "index": "ap",
      "isDeleted": false,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "angle": 0,
      "backgroundColor": "transparent",
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "updated": 1777781860969,
      "link": null,
      "locked": false,
      "originalText": "Legend:\n── (solid + filled ▶)  Sync call (sender blocks)\n─▷ (solid + open ▷)   Async / fire-and-forget\n╌╌ (dashed + filled ▶) Cron / polling\n╌╌▷ (dashed + open ▷)  Secondary background async\n\n↓ Arrows point from initiator to dependency\n\nColor → role:\n  blue   = UI / Frontend\n  teal   = Service / API / Worker\n  orange = DB / Cache / Store\n  red    = Queue / Stream\n  gray   = External system\n  indigo = Person / User\n\nAll nodes: rounded rect. Role = color + label.\n[] = tech    () = status\n\n╌╌╌ GROUPING BOUNDARY (dashed)",
      "autoResize": true,
      "lineHeight": 1.981818181818182
    },
